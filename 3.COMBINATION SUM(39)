class Solution:

    def combinationSum(self, candidates: list[int], target: int) -> list[list[int]]:
        res = []
        curr = []

        def dfs(i, total):
            if total == target:
                res.append(curr.copy())
                return
            if i >= len(candidates) or total > target:
                return

            curr.append(candidates[i])
            dfs(i, total + candidates[i])
            curr.pop()

            dfs(i + 1, total)

        dfs(0, 0)
        return res


if __name__ == "__main__":
    solution = Solution()

    cand1, target1 =, 7
    print(f"Input: candidates = {cand1}, target = {target1}")
    print(f"Output: {solution.combinationSum(cand1, target1)}\n")

    cand2, target2 =, 8
    print(f"Input: candidates = {cand2}, target = {target2}")
    print(f"Output: {solution.combinationSum(cand2, target2)}\n")

    cand3, target3 =, 1
    print(f"Input: candidates = {cand3}, target = {target3}")
    print(f"Output: {solution.combinationSum(cand3, target3)}")
