        [".", ".", ".", "4", "1", "9", ".", ".", "5"],
        [".", ".", ".", ".", "8", ".", ".", "7", "9"],
    ]

    print("Input Board:")
    for row in example_board:
        print(row)

    solution.solveSudoku(example_board)

    print("\nSolved Board:")
    for row in example_board:
        print(row)
